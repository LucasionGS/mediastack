# ── User/Group IDs ─────────────────────────────────────────────────
# Run: id $USER to get these values
PUID=1000
PGID=1000

# ── Traefik & Domain ───────────────────────────────────────────────
WEB_PORT=80
DOMAIN=media.local
DOMAIN_PROWLARR="prowlarr.${DOMAIN}"
DOMAIN_SONARR="sonarr.${DOMAIN}"
DOMAIN_RADARR="radarr.${DOMAIN}"
DOMAIN_WHISPARR="whisparr.${DOMAIN}"
DOMAIN_BAZARR="bazarr.${DOMAIN}"
DOMAIN_PLEX="plex.${DOMAIN}"
DOMAIN_QBITTORRENT="qbit.${DOMAIN}"
DOMAIN_SEERR="seerr.${DOMAIN}"

# ── Timezone ───────────────────────────────────────────────────────
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Copenhagen

# ── Plex Claim Token ───────────────────────────────────────────────
# Get yours at: https://www.plex.tv/claim (expires in 4 minutes)
PLEX_CLAIM=claim-XXXXXXXXXXXXXXXXXXXX

# ── Paths ──────────────────────────────────────────────────────────
# Config: where each app stores its settings/database
CONFIG_DIR=/opt/mediastack/config

# Media: your media folder or your ZFS datasets
MEDIA_DIR=/media/mediapool

# Downloads: where qBittorrent dumps files before Sonarr/Radarr moves them
DOWNLOAD_DIR=/media/mediapool/downloads

# Proxy values if using VPN mode
VPN_SERVICE_PROVIDER=windscribe
VPN_TYPE=openvpn
OPENVPN_USER=WINDSCRIBE_USER
OPENVPN_PASSWORD=WINDSCRIBE_PASS
SERVER_REGIONS=Netherlands